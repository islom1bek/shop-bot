BOT_TOKEN=123456:ABC...
# Neon: строка подключения из дашборда (с ?sslmode=require)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Публичный HTTPS-адрес, по которому открывается Mini App (без / на конце)
WEBAPP_URL=https://shop.example.com
DOMAIN=shop.example.com
# Telegram ID админов через запятую
ADMIN_IDS=111111111,222222222
# Общий секрет между парсером @CardXabarBot и /webhook/cardxabar (openssl rand -hex 24)
WEBHOOK_SECRET=change_me
PORT=8080

# Только для parser/cardxabar_listener.py (my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=
WEBHOOK_URL=http://bot:8080/webhook/cardxabar
